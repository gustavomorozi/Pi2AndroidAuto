# Test helpers for the Pi build (userdebug). Installed at /system/etc/init/.
service morozi_usbctl /system/bin/sh /system/bin/morozi_usbctl.sh
    user root
    group root
    seclabel u:r:su:s0
    oneshot
    disabled

on property:debug.morozi.usb=off
    start morozi_usbctl

on property:debug.morozi.usb=on
    start morozi_usbctl

on property:debug.morozi.usb=rebind
    start morozi_usbctl

# Leave accessory mode when the car repeats the AOA start (see the script).
# Turn off with: setprop debug.morozi.aoawatch 0
service morozi_aoawatch /system/bin/sh /system/bin/morozi_aoawatch.sh
    user root
    group root
    seclabel u:r:su:s0
    disabled

on property:sys.boot_completed=1
    start morozi_aoawatch
    # Present ourselves like the CarlinKit TBox does ("Google" / "Pixel"),
    # the identity its phone role uses toward the car. Takes effect on the
    # next enumeration.
    write /config/usb_gadget/g1/strings/0x409/manufacturer Google
    write /config/usb_gadget/g1/strings/0x409/product Pixel

on property:debug.morozi.aoawatch=0
    stop morozi_aoawatch

on property:debug.morozi.aoawatch=1
    start morozi_aoawatch
